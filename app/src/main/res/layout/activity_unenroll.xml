<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        style="@style/Widget.Mdm.Toolbar"
        app:title="Unenroll Device"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_gutter">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Removing management clears all restrictions and Device Owner status. The administrator password is required."
                style="@style/Text.Caption"
                android:layout_marginBottom="@dimen/space_lg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Administrator password" style="@style/Input.Outlined"
                android:layout_marginBottom="@dimen/space_lg">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPassword" android:textColor="@color/text_primary"
                    android:maxLines="1" android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_unenroll"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Unenroll This Device" style="@style/Button.Danger"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
