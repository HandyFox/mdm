<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Toolbar -->
    <style name="Widget.Mdm.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/bg_elevated</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Mdm.Toolbar</item>
    </style>

    <style name="TextAppearance.Mdm.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- Screen title (big heading inside a screen) -->
    <style name="Text.Title">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Section header: PRIMARY-TINTED, CAPS -->
    <style name="Text.Section">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:layout_marginTop">@dimen/space_lg</item>
        <item name="android:layout_marginBottom">@dimen/space_sm</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Primary filled button -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Secondary / outlined button -->
    <style name="Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Text input -->
    <style name="Input.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxBackgroundColor">@color/bg_elevated</item>
    </style>
</resources>
